# -*- coding: utf-8 -*-
# even_n_источник.sage
# Восстановление источника утверждения Бойера «при чётном n красные клетки не квадраты»
# (Wesolowski, multimagie.com / SquaresOfSquaresSearch.htm, записи 20-22.12.2019)
# и проверка, переносится ли оно на всё семейство G1.
#
# Все выводы помечены: [доказано] / [проверено численно] / [наблюдение].

print("="*78)
print("ЧАСТЬ 0. Клетки G1 из параметризации Бремнера — вывод формул c2, c6")
print("="*78)

R.<m,n,p> = PolynomialRing(QQ, 3)
# Сегре-параметризация двух рёберных пар при q=1:
P_ = m*p + n; Q_ = m - n*p; Rr = m*p - n; S_ = m + n*p
c  = (P_^2 + Q_^2)/2
assert (Rr^2 + S_^2)/2 == c, "две пары дают разные центры"
a  = (Q_^2 - P_^2 + S_^2 - Rr^2)/4
b  = (Q_^2 - P_^2 - S_^2 + Rr^2)/4
cell = {0: c+a, 1: c-a-b, 2: c+b, 3: c-a+b, 4: c, 5: c+a-b, 6: c-b, 7: c+a+b, 8: c-a}
# контроль магичности
lines = [(0,1,2),(3,4,5),(6,7,8),(0,3,6),(1,4,7),(2,5,8),(0,4,8),(2,4,6)]
assert all(sum(cell[i] for i in L) == 3*cell[4] for L in lines), "квадрат не магический"
s  = (m^2+n^2)/2
F0 = m^2 + n^2*p^2; F4 = s*(1+p^2); F8 = n^2 + m^2*p^2
assert cell[0] == F0 and cell[4] == F4 and cell[8] == F8
assert cell[1] == P_^2 and cell[7] == Q_^2 and cell[3] == Rr^2 and cell[5] == S_^2
print("[доказано] c0=F0, c4=F4, c8=F8; c1,c3,c5,c7 — автоматические квадраты.")
print("[доказано] КРАСНЫЕ клетки G1 (две свободные):")
print("   c2 = F4 - 2*m*n*p =", cell[2])
print("   c6 = F4 + 2*m*n*p =", cell[6])
assert cell[2] == F4 - 2*m*n*p and cell[6] == F4 + 2*m*n*p

print()
print("="*78)
print("ЧАСТЬ 1. Семейство Весоловского = G1 ∩ {c2, c6 — квадраты}")
print("="*78)
# Бойер, страница Search, 20-22.12.2019 (сохранённая копия страницы разобрана отдельно):
#   (xy-z)^2  (xz+y)^2  x^2+y^2 z^2
#   (x+yz)^2  (x^2+y^2)(z^2+1)/2  (xz-y)^2
#   x^2 z^2+y^2  (yz-x)^2  (xy+z)^2
W = {0: (m*n-p)^2, 1: (m*p+n)^2, 2: m^2+n^2*p^2,
     3: (m+n*p)^2, 4: (m^2+n^2)*(p^2+1)/2, 5: (m*p-n)^2,
     6: m^2*p^2+n^2, 7: (n*p-m)^2, 8: (m*n+p)^2}
# соответствие с нашим G1 при (x,y,z)=(m,n,p) с точностью до транспонирования/поворота D8:
# W2=c0, W6=c8, W4=c4, W1=c1, W3=c5, W5=c3, W7=c7, W0 ~ c2, W8 ~ c6
print("[доказано] красные клетки Бойера = {x²+y²z², (x²+y²)(z²+1)/2, x²z²+y²} = {F0, F4, F8},")
print("           то есть РОВНО три условия нашей кривой C рода 5, а НЕ наши c2, c6.")
magic_W = W[0]+W[1]+W[2] - 3*W[4]
print("[доказано] квадрат Весоловского магический только при условии")
print("           2x²y² + 2z² = (x²+y²)(z²+1);  невязка первой строки =", magic_W.factor())
# это же условие = «c2 квадрат» в G1:
diff = (cell[2] - (m*n-p)^2)
print("[доказано] c2 = (mn-p)²  ⟺  то же условие; c2-(mn-p)² =", diff.factor())
assert diff == -magic_W, "условие магичности W и условие «c2 квадрат» должны совпадать"
assert cell[6] - (m*n+p)^2 == -magic_W, "то же для c6"
print("           ⇒ семейство Весоловского = G1, суженное условием «c2 и c6 — квадраты»,")
print("             а его открытый вопрос — квадратность F0, F4, F8. КОМПЛЕМЕНТАРНО нашему.")

print()
print("="*78)
print("ЧАСТЬ 2. Что означает 'n' у Бойера: индекс рекурренты, не параметр")
print("="*78)
xs, ys, zs = [3], [1], [1]
for i in range(1, 12):
    x0, z0 = xs[-1], zs[-1]
    xs.append(3*x0 + 2*z0); ys.append(x0); zs.append(x0 + z0)
print(" i : (x,y,z)                      x%2 y%2 z%2 | v2(F0) v2(F4) v2(F8)")
rows = []
for i in range(0, 9):
    x, y, z = xs[i], ys[i], zs[i]
    f0 = x^2 + y^2*z^2; f4 = (x^2+y^2)*(z^2+1)/2; f8 = x^2*z^2 + y^2
    rows.append((i, x, y, z, f0, f4, f8))
    print(f"{i:2d} : ({x},{y},{z})".ljust(34)
          + f"{x%2}   {y%2}   {z%2} | {f0.valuation(2):5d} {QQ(f4).valuation(2):5d} {f8.valuation(2):5d}")
# контроль со страницей: i=1 -> (11,3,4), F0=265, F4=1105, F8=1945
assert (xs[1], ys[1], zs[1]) == (11, 3, 4)
assert (xs[2], ys[2], zs[2]) == (41, 11, 15)
assert (xs[3], ys[3], zs[3]) == (153, 41, 56)
i1 = rows[1]; assert (i1[4], i1[5], i1[6]) == (265, 1105, 1945), "не совпало с таблицей Бойера"
i2 = rows[2]; assert (i2[4], i2[5], i2[6]) == (28906, 203626, 378346), "не совпало с таблицей Бойера"
i3 = rows[3]; assert i3[4] == 5295025 and i3[6] == 73412305, "не совпало с таблицей Бойера"
print("[проверено численно] значения совпали с таблицей на странице multimagie (i=1,2,3).")
print("[доказано] по рекурренте mod 2: x(i)≡x(i-1), y(i)=x(i-1) ⇒ x,y ВСЕГДА нечётны;")
print("           z(i)≡z(i-1)+1, z(0)=1 ⇒ z(i) нечётно ⟺ i чётно.")
assert all(xs[i] % 2 == 1 and ys[i] % 2 == 1 for i in range(9))
assert all((zs[i] % 2 == 1) == (i % 2 == 0) for i in range(9))
print("           ⇒ 'чётное n' у Бойера = 'z нечётно при нечётных x,y'.")

print()
print("="*78)
print("ЧАСТЬ 3. Восстановленное доказательство (mod 8) и его обобщение на всё G1")
print("="*78)
print("[доказано] Пусть x,y,z все нечётны. Тогда x²≡y²≡z²≡1 (mod 8) и")
print("   F0 = x²+y²z² ≡ 2 (mod 8),  F8 = x²z²+y² ≡ 2 (mod 8),")
print("   F4 = (x²+y²)/2 · (z²+1):  (x²+y²)/2 нечётно, z²+1 ≡ 2 (mod 8) ⇒ F4 ≡ 2·нечёт (mod 16).")
print("   Во всех трёх случаях v₂ = 1 — нечётная валюация ⇒ ни одно не квадрат. ∎")
# исчерпывающая проверка mod 8 (это и есть всё доказательство)
bad = [(x,y,z) for x in range(1,16,2) for y in range(1,16,2) for z in range(1,16,2)
       if not (ZZ(x^2+y^2*z^2).valuation(2)==1 and ZZ(x^2*z^2+y^2).valuation(2)==1
               and QQ((x^2+y^2)*(z^2+1)/2).valuation(2)==1)]
print("[проверено численно] контрпримеров среди нечётных x,y,z<16:", len(bad))
assert not bad

print()
print("--- перенос на ВСЁ G1: t = u/v в несократимом виде, однородные формы ---")
# F0 = (m²v²+n²u²)/v², F8 = (n²v²+m²u²)/v², F4 = (m²+n²)(u²+v²)/(2v²)
def v2list(m_, n_, u_, v_):
    f0 = m_^2*v_^2 + n_^2*u_^2
    f8 = n_^2*v_^2 + m_^2*u_^2
    f4 = QQ((m_^2+n_^2)*(u_^2+v_^2))/2
    return ZZ(f0).valuation(2), QQ(f4).valuation(2), ZZ(f8).valuation(2)

print("A) m,n оба нечётны и u,v оба нечётны:")
bad = [(m_,n_,u_,v_) for m_ in range(1,20,2) for n_ in range(1,20,2) if gcd(m_,n_)==1
       for u_ in range(1,14,2) for v_ in range(1,14,2) if gcd(u_,v_)==1
       if v2list(m_,n_,u_,v_) != (1,1,1)]
print("   контрпримеров к v₂=(1,1,1):", len(bad)); assert not bad
print("   [доказано] ⇒ при m,n нечётных параметр t=u/v ОБЯЗАН иметь u+v нечётным")
print("              (в частности, целое t обязано быть чётным). Это и есть утверждение Бойера,")
print("              перенесённое с рекуррентной кривой на ВСЁ G1.")

print("B) m,n разной чётности (наш случай (13,8),(15,8),(19,16),(16,5)):")
print("   v₂(2(m²+n²)(u²+v²)) = 1+v₂(u²+v²); квадратность F4 требует v₂(u²+v²) нечётным,")
print("   а при gcd(u,v)=1 это ровно случай u,v ОБА НЕЧЁТНЫ (тогда v₂(u²+v²)=1).")
bad = []
for m_, n_ in [(13,8),(15,8),(19,16),(16,5)]:
    for u_ in range(1,30):
        for v_ in range(1,30):
            if gcd(u_,v_) != 1: continue
            f4num = QQ((m_^2+n_^2)*(u_^2+v_^2))/2
            ok_parity = (u_ % 2 == 1 and v_ % 2 == 1)
            ok_v2 = (f4num.valuation(2) % 2 == 0)
            if ok_parity != ok_v2: bad.append((m_,n_,u_,v_))
print("   расхождений «u,v оба нечётны ⟺ v₂(F4) чётно»:", len(bad)); assert not bad
print("   [доказано] условие на t ПРОТИВОПОЛОЖНО случаю A. Никакой пары (m,n) оно не убивает.")

print()
print("="*78)
print("ЧАСТЬ 4. Есть ли 2-адическое препятствие у четырёх оставшихся пар — НЕТ")
print("="*78)
def is_2adic_square(q):
    q = QQ(q)
    if q == 0: return True
    e = q.valuation(2)
    if e % 2: return False
    return (q / 2^e).numerator() * (q / 2^e).denominator() % 8 == 1

print("(m,n)   | t=u/v |  F0        F4        F8      | все 2-адические квадраты?")
for m_, n_ in [(13,8),(15,8),(19,16),(16,5)]:
    found = []
    for v_ in range(1,40,2):
        for u_ in range(1,40,2):
            if gcd(u_,v_)!=1: continue
            t = QQ(u_)/QQ(v_)
            f0 = m_^2 + n_^2*t^2; f4 = QQ(m_^2+n_^2)*(1+t^2)/2; f8 = n_^2 + m_^2*t^2
            if is_2adic_square(f0) and is_2adic_square(f4) and is_2adic_square(f8):
                found.append((t, f0, f4, f8))
    t, f0, f4, f8 = found[0]
    print(f"({m_},{n_})".ljust(8) + f"| {t}".ljust(8)
          + f"| {f0}  {f4}  {f8}".ljust(30) + f"| ДА (таких t среди u,v<40: {len(found)})")
    assert found, "не нашлось ни одного t"

print()
print("[доказано] Прямое рассуждение, без перебора (m нечётно, 8|n или 4|n):")
print("   при u,v нечётных F0 = m²v²+n²u² ≡ m²v² ≡ 1 (mod 8) и F8 ≡ 1 (mod 8) автоматически;")
print("   F4 — квадрат в Q₂ ⟺ (m²+n²)·(u²+v²)/2 ≡ 1 (mod 8), выполнимо (например u=v=1).")
for m_, n_ in [(13,8),(15,8),(19,16)]:
    print(f"   ({m_},{n_}): m²+n² = {m_^2+n_^2} ≡ {(m_^2+n_^2)%8} (mod 8); при t=1 все три = {m_^2+n_^2}",
          "— 2-адический квадрат" if is_2adic_square(m_^2+n_^2) else "— НЕ 2-адический квадрат")
print("   (16,5): m чётно, роли m,n симметричны; m²+n² =", 16^2+5^2, "≡", (16^2+5^2)%8, "(mod 8)")

print()
print("--- известная точка (15,8), t=1 (Codex): контроль ---")
m_, n_, t = 15, 8, QQ(1)
f0 = m_^2+n_^2*t^2; f4 = QQ(m_^2+n_^2)*(1+t^2)/2; f8 = n_^2+m_^2*t^2
print(f"   F0={f0}={sqrt(f0)}², F4={f4}={sqrt(f4)}², F8={f8}={sqrt(f8)}² — три НАСТОЯЩИХ квадрата")
assert f0.is_square() and f4.is_square() and f8.is_square()
print("   [доказано] ⇒ у (15,8) точка на C существует (вырожденная), 2-адического запрета нет и подавно.")

print()
print("="*78)
print("ЧАСТЬ 5. Красные клетки G1 (c2, c6) при чётном n — тоже без 2-адического запрета")
print("="*78)
print("(m,n)  t=u/v :  c2        c6      | c2,c6 2-адические квадраты?")
for m_, n_ in [(13,8),(15,8),(19,16),(16,5)]:
    hits = 0; first = None
    for v_ in range(1,40,2):
        for u_ in range(1,40,2):
            if gcd(u_,v_)!=1: continue
            t = QQ(u_)/QQ(v_)
            f0 = m_^2+n_^2*t^2; f4 = QQ(m_^2+n_^2)*(1+t^2)/2; f8 = n_^2+m_^2*t^2
            if not (is_2adic_square(f0) and is_2adic_square(f4) and is_2adic_square(f8)): continue
            c2v = f4 - 2*m_*n_*t; c6v = f4 + 2*m_*n_*t
            if c2v != 0 and c6v != 0 and is_2adic_square(c2v) and is_2adic_square(c6v):
                hits += 1
                if first is None: first = (t, c2v, c6v)
    t, c2v, c6v = first
    print(f"({m_},{n_})  t={t}".ljust(20) + f"| {c2v}  {c6v}".ljust(24)
          + f"| ДА (таких t: {hits})")
print("[доказано] ⇒ ВСЕ ПЯТЬ клеток (F0,F4,F8,c2,c6) одновременно 2-адические квадраты")
print("           при подходящем t у каждой из четырёх пар. 2-адического препятствия НЕТ")
print("           ни для семи квадратов, ни даже для девяти.")

print()
print("="*78)
print("ПРИЛОЖЕНИЕ. Второе семейство Весоловского (май 2020): половина даётся тем же mod 8")
print("="*78)
print("Там Бойер доказательства НЕ заявляет — только проверку n < 10^10. Но при НЕЧЁТНОМ n")
print("работает тот же 2-адический аргумент.")
Rn.<N> = PolynomialRing(QQ)
w_ = 6*N^2 + 6*N + 2; x_ = 2*N + 1; y_ = 3*N^2 + 2*N; z_ = 3*N^2 + 4*N + 1
r1 = (2*y_^2 - z_^2)*x_^2 + (2*z_^2 - y_^2)*w_^2
r2 = 2*(x_^2*y_^2 + w_^2*z_^2) - (w_*y_ + x_*z_)^2
r3 = 2*(x_^2*y_^2 + w_^2*z_^2) - (w_*y_ - x_*z_)^2
# контроль с таблицей страницы при n=1: красные клетки 20062, 16702, 23422
vals1 = sorted([ZZ(r1(1)), ZZ(r2(1)), ZZ(r3(1))])
print("   n=1: красные клетки", vals1, "— на странице 20062, 16702, 23422:",
      "совпало" if vals1 == sorted([20062, 16702, 23422]) else "НЕ совпало")
assert vals1 == sorted([20062, 16702, 23422])
print("   n : v2(r1) v2(r2) v2(r3)   (n нечётно ⇒ все три = 1 ⇒ не квадраты)")
bad2 = []
for k in range(1, 41):
    vs = tuple(ZZ(r(k)).valuation(2) for r in (r1, r2, r3))
    if k <= 8: print(f"   {k:2d} :   {vs[0]}      {vs[1]}      {vs[2]}")
    if k % 2 == 1 and vs != (1, 1, 1): bad2.append(k)
print("   нарушений 'n нечётно ⇒ v2=(1,1,1)' при n<=40:", len(bad2)); assert not bad2
print("[доказано] при n нечётном: x,y нечётны, v₂(w)=1, 8|z ⇒")
print("   2(x²y²+w²z²) имеет v₂=1, а (wy±xz)² имеет v₂=2 ⇒ v₂(r2)=v₂(r3)=1;")
print("   (2y²−z²)x² имеет v₂=1, (2z²−y²)w² имеет v₂=2 ⇒ v₂(r1)=1. Ни одно не квадрат. ∎")
print("[наблюдение] при n чётном все три красные клетки НЕЧЁТНЫ — 2-адического запрета нет,")
print("   что согласуется с тем, что Бойер там даёт только численную проверку.")

print()
print("="*78)
print("ИТОГ")
print("="*78)
print("1. [доказано] Утверждение Бойера про 'чётное n' — про ИНДЕКС рекурренты Весоловского,")
print("   а не про наш параметр n пары (m,n). Чётный индекс ⟺ z=t нечётно при x=m, y=n нечётных.")
print("2. [доказано] Его красные клетки — это F0, F4, F8 (наша кривая C), а НЕ наши c2, c6.")
print("3. [доказано] Доказательство восстанавливается: v₂(F0)=v₂(F4)=v₂(F8)=1 при m,n,t нечётных.")
print("   Обобщение на всё G1: при m,n нечётных необходимо u+v нечётно (t 'чётное').")
print("4. [доказано] У (13,8),(15,8),(19,16),(16,5) чётность m,n РАЗНАЯ; там условие обратное")
print("   (u,v оба нечётны) и выполнимо. 2-адического препятствия нет. Пары НЕ закрываются.")
