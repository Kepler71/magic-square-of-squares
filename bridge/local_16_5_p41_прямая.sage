# -*- coding: utf-8 -*-
# ПРЯМАЯ ПРОВЕРКА локального исключения пары (m,n) = (16,5) по модулю 41.
#
# Проверяемое утверждение (Codex, PARALLEL_RESULT_FULL_NINE_126_2026-09-12.md, раздел «(16,5), p=41»):
#   «полная система девяти клеток для этой пары не имеет решений уже над F_41»;
#   «противоречие возникает до требования положительности и попарной различности клеток».
#
# Устройство проверки. Файл состоит из двух частей:
#   (A) НЕЗАВИСИМЫЙ ВЫВОД девяти клеток средствами Sage — из аксиом магического квадрата,
#       без обращения к формулам из чужих файлов; сверка с формулами проекта в конце;
#   (B) запуск ядра local_16_5_p41_ядро_КЛОД.py (чистый Python, точная арифметика Fraction/isqrt):
#       §0 повторный вывод клеток независимым CAS (sympy) — два CAS против одной формулы;
#       §1 контроли: параметры с известным ГЛОБАЛЬНЫМ решением обязаны выживать при каждом p;
#       §2 полный перебор всех 42 точек P^1(F_41), пять неавтоматических клеток;
#       §3 второе кодирование: все 1680 пар (a,b) != (0,0), девять клеток, таблица квадратов;
#       §4 построчная сверка с таблицей Codex;
#       §5 вырождения: нули, совпадения, положительность — от чего вывод зависит, от чего нет;
#       §6 независимый подъём в Q_41 (рекурсия по дискам + Гензель) с контролем процедуры;
#       §7 минимальное исключающее p; запрещённые классы λ = m/n при p = 41 и p = 17.
#
# Запуск:  sage /home/kep/magicKube/bridge/local_16_5_p41_прямая.sage
# Ядро отдельно: python3 /home/kep/magicKube/bridge/local_16_5_p41_ядро_КЛОД.py
#
# ВАЖНО про препарсер Sage: числовая часть вынесена в отдельный .py именно потому, что препарсер
# превращает целые литералы в Integer, а fractions.Fraction с Integer несовместим. runpy исполняет
# ядро как обычный Python, без препарсера.

import runpy, os

print("=" * 100)
print("A. НЕЗАВИСИМЫЙ ВЫВОД ДЕВЯТИ КЛЕТОК В SAGE (аксиомы магического квадрата, не чужие формулы)")
print("=" * 100)

R = PolynomialRing(QQ, ['a', 'b', 'm', 'n'])
a, b, m, n = R.gens()

# Ассоциативность: центр C, все восемь линий = 3C, каждая пара противоположных клеток = 2C.
#   c0 = C+al, c8 = C-al;  c1 = C+be, c7 = C-be;  c2 = C+ga, c6 = C-ga;  c3 = C+de, c5 = C-de.
#   строка 0:   al+be+ga = 0
#   столбец 0:  de = ga - al
# Семейство G1 фиксируется требованием «четыре рёберные клетки — квадраты линейных форм»:
c1 = (a*m + b*n)**2
c3 = (a*m - b*n)**2
c5 = (a*n + b*m)**2
c7 = (a*n - b*m)**2

print("  обе рёберные пары дают ОДИН центр (c1+c7 == c3+c5):", (c1 + c7) == (c3 + c5))
C  = (c1 + c7) / 2
be = c1 - C
de = c3 - C
ga = (de - be) / 2          # из al+be+ga = 0 и de = ga-al следует 2*ga = de-be
al = -be - ga
c0, c8 = C + al, C - al
c2, c6 = C + ga, C - ga
c4 = C
cells = [c0, c1, c2, c3, c4, c5, c6, c7, c8]

print("  c4 =", c4)
print("     == (a^2+b^2)(m^2+n^2)/2 = F4 :", c4 == (a*a + b*b)*(m*m + n*n)/2)
print("  c0 =", c0, "\n     == n^2 a^2 + m^2 b^2 = F0 :", c0 == n*n*a*a + m*m*b*b)
print("  c8 =", c8, "\n     == m^2 a^2 + n^2 b^2 = F8 :", c8 == m*m*a*a + n*n*b*b)
print("  c2 == F4 - 2mn*ab = L :", c2 == c4 - 2*m*n*a*b)
print("  c6 == F4 + 2mn*ab = U :", c6 == c4 + 2*m*n*a*b)

LINES = [(0,1,2),(3,4,5),(6,7,8),(0,3,6),(1,4,7),(2,5,8),(0,4,8),(2,4,6)]
print("  все восемь линий = 3*c4:", all(cells[i] + cells[j] + cells[k] == 3*c4 for i, j, k in LINES))
print("  все четыре пары противоположных клеток = 2*c4:",
      all(cells[i] + cells[8-i] == 2*c4 for i in range(4)))
print("  тождества проекта: c2+c6 = 2c4:", c2 + c6 == 2*c4,
      "; 2c2 = c3+c7:", 2*c2 == c3 + c7, "; 2c6 = c1+c5:", 2*c6 == c1 + c5)

# Какие клетки — квадраты ТОЖДЕСТВЕННО. Проверка в кольце многочленов: c_i есть полный квадрат
# <=> 4*c_i полный квадрат (4 — квадрат, знаменатель 2 уходит).  is_square() решает это точно.
auto = [i for i in range(9) if R(4*cells[i]).is_square()]
print("  ТОЖДЕСТВЕННЫЕ (автоматические) квадраты — клетки", auto, "; ожидались рёбра [1,3,5,7]:",
      auto == [1, 3, 5, 7])
print("  НЕАВТОМАТИЧЕСКИЕ (проверяемые) — ", [i for i in range(9) if i not in auto],
      "; ожидались [0,2,4,6,8]:", [i for i in range(9) if i not in auto] == [0, 2, 4, 6, 8])
print("  контроль к чужому логу: c0 = a^2n^2 + b^2m^2 НЕ квадрат тождественно:",
      not R(4*c0).is_square(), "; c8 НЕ квадрат тождественно:", not R(4*c8).is_square())
print("  ИТОГ A: пять неавтоматических клеток — это ровно F0, L, F4, U, F8. Их и перебираем.")

print()
print("=" * 100)
print("B. ЧИСЛОВАЯ ЧАСТЬ (ядро в чистом Python, без препарсера)")
print("=" * 100)
core = os.path.join(os.path.dirname(os.path.abspath('local_16_5_p41_прямая.sage')),
                    'local_16_5_p41_ядро_КЛОД.py')
if not os.path.exists(core):
    core = '/home/kep/magicKube/bridge/local_16_5_p41_ядро_КЛОД.py'
runpy.run_path(core, run_name='__main__')
