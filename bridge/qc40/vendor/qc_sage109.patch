+def _qc_infinity(C):
+    # Weighted coordinates (X:Y:Z), weights (1,g+1,1).
+    f,h=C.hyperelliptic_polynomials()
+    assert h==0
+    if f.degree()%2:
+        return C(1,0,0)
+    root=C.base_ring()(f.leading_coefficient()).sqrt()
+    return C(1,root,0)
+
+def _qc_point_key(P):
+    # Canonical coordinates avoid Sage 10.9's false equality modulo roots of unity.
+    if P[2] != 0:
+        return (P[0]/P[2], P[1]/P[2]^3, P[2].parent()(1))
+    return (P[0].parent()(1), P[1]/P[0]^3, P[0].parent()(0))
+
+def _qc_unique_points(points):
+    found={}
+    for P in points:
+        found.setdefault(_qc_point_key(P),P)
+    return list(found.values())
+
 
