# -*- coding: utf-8 -*-
# 2-адическая атака на семейство G1 при чётном n.
# Вопрос: верно ли, что при чётном n две «красные» клетки G1 не могут быть квадратами,
# и доказуемо ли это 2-адически на ВСЁМ G1 (а не только на кривой Весоловского)?
#
# Всё выводится с нуля: параметризация Сегре -> девять клеток -> v_2 и вычеты mod 8/16/32.
#
# Запуск: sage /home/kep/magicKube/bridge/even_n_2адика.sage

import itertools, functools
print = functools.partial(print, flush=True)

print("="*100)
print("ЧАСТЬ 1. Вывод девяти клеток G1 с нуля и символическая проверка")
print("="*100)

# ---------------------------------------------------------------------------
# Параметризация Сегре квадрики P^2+Q^2 = R^2+S^2 = 2c  (см. BREMNER16 §2.2):
#     P = m p + n q,  Q = m q - n p,  R = m p - n q,  S = m q + n p.
# G1 = «две полные РЁБЕРНЫЕ пары»: {c1,c7} и {c3,c5}.
#     c1 = P^2, c7 = Q^2, c3 = R^2, c5 = S^2,  c4 = центр = (P^2+Q^2)/2.
# Остальные четыре клетки восстанавливаются из магичности однозначно.
# ---------------------------------------------------------------------------
Rpoly = PolynomialRing(QQ, ['m','n','p','q'])
m, n, p, q = Rpoly.gens()

P = m*p + n*q
Q = m*q - n*p
Rr = m*p - n*q
S = m*q + n*p

c1, c7, c3, c5 = P^2, Q^2, Rr^2, S^2
c4 = (c1 + c7)/2                      # = (m^2+n^2)(p^2+q^2)/2
assert c4 == (c3 + c5)/2, "пары не согласованы"

# магичность: c0 = 3c4 - c1 - c2 и т.д.  Выводим c0 из строки/столбца:
# c0 + c1 + c2 = 3c4, c0 + c3 + c6 = 3c4, c2 + c6 = 2c4  =>  c0 = 2c4 - (c1+c3)/2
c0 = 2*c4 - (c1 + c3)/2
c8 = 2*c4 - c0
c2 = 3*c4 - c0 - c1
c6 = 2*c4 - c2

cells = [c0,c1,c2,c3,c4,c5,c6,c7,c8]

# Проверка магичности
lines = [(0,1,2),(3,4,5),(6,7,8),(0,3,6),(1,4,7),(2,5,8),(0,4,8),(2,4,6)]
for L in lines:
    assert sum(cells[i] for i in L) == 3*c4, f"строка {L} не магическая"
print("[доказано] Все 8 линий дают 3*c4 — квадрат магический при ЛЮБЫХ m,n,p,q.")

F0 = m^2*q^2 + n^2*p^2
F4 = (m^2+n^2)*(p^2+q^2)/2
F8 = n^2*q^2 + m^2*p^2
assert c0 == F0 and c4 == F4 and c8 == F8
print("[доказано] c0 = m^2 q^2 + n^2 p^2 = F0,  c4 = (m^2+n^2)(p^2+q^2)/2 = F4,  c8 = n^2 q^2 + m^2 p^2 = F8")
print("           (в однородном виде t = p/q это в точности F0 = m^2+n^2 t^2, F4 = s(1+t^2), F8 = n^2+m^2 t^2)")

# КРАСНЫЕ клетки
red2 = F4 - 2*m*n*p*q
red6 = F4 + 2*m*n*p*q
assert c2 == red2 and c6 == red6
print("[доказано] КРАСНЫЕ клетки:  c2 = F4 - 2mn pq,   c6 = F4 + 2mn pq.")
print("           Тождества: c2 + c6 = 2 F4,  c2 * c6 = F4^2 - (2mn pq)^2.")

print()
print("Итоговая таблица девяти клеток G1 (t = p/q, всё умножено на q^2):")
print("   c0 = m^2 q^2 + n^2 p^2        c1 = (m p + n q)^2         c2 = (m^2+n^2)(p^2+q^2)/2 - 2mn pq")
print("   c3 = (m p - n q)^2            c4 = (m^2+n^2)(p^2+q^2)/2  c5 = (m q + n p)^2")
print("   c6 = (m^2+n^2)(p^2+q^2)/2+2mn pq   c7 = (m q - n p)^2    c8 = n^2 q^2 + m^2 p^2")
print("Автоматические квадраты: c1,c3,c5,c7.  Условия: c0,c4,c8 (кривая C рода 5, семь квадратов)")
print("                         + c2,c6 (красные) = девять квадратов.")

# положительность красных клеток (нет вещественного препятствия)
print()
print("[доказано] c2, c6 > 0 всегда при m != n: дискриминант формы s X^2 - 2mn X + s  по X=p/q равен")
print("           4m^2n^2 - (m^2+n^2)^2 = -(m^2-n^2)^2 < 0.  Вещественного препятствия нет.")

# численная проверка магичности на случайных значениях
import random
for _ in range(200):
    mm = random.randrange(1, 60); nn = random.randrange(1, 60)
    pp = random.randrange(-30, 30); qq = random.randrange(1, 30)
    vals = [ZZ(cc(mm,nn,pp,qq)*2)/2 for cc in cells]
    assert all(sum(vals[i] for i in L) == 3*vals[4] for L in lines)
print("[проверено численно] 200 случайных (m,n,p,q): магичность выполняется.")

print()
print("="*100)
print("ЧАСТЬ 2. Целочисленность и чётности (какие p,q вообще допустимы)")
print("="*100)

def cells_int(mm, nn, pp, qq):
    """девять клеток как рациональные числа (умноженные на q^2)"""
    return [QQ(cc(mm,nn,pp,qq)) for cc in cells]

print("""
Клетки должны быть квадратами РАЦИОНАЛЬНЫХ чисел. Так как c1 = (mp+nq)^2 — уже квадрат,
общий множитель масштабирования обязан быть квадратом, т.е. каждое c_i должно быть квадратом в Q.
Значит достаточно смотреть на v_2 и вычеты.

Случай A: m нечётно, n чётно (gcd(m,n)=1).  Тогда m^2+n^2 нечётно.
  F4 = (m^2+n^2)(p^2+q^2)/2.  Если p,q разной чётности, то p^2+q^2 нечётно и v_2(F4) = -1 (нечётно)
  => F4 не квадрат.  Значит p,q ОБА НЕЧЁТНЫ (gcd(p,q)=1 не даёт обоим быть чётными).
  Эквивалентно: t = p/q — 2-адическая единица.

Случай B: m,n оба нечётны.  Тогда s = (m^2+n^2)/2 — целое нечётное.
  Если p,q оба нечётны: F0 = m^2q^2+n^2p^2 = 1+1 = 2 (mod 8) => v_2(F0) = 1 нечётно => не квадрат.
  Значит ровно одно из p,q чётно.
""")

def parity_check(mm, nn, pp, qq):
    """проверяет v_2 всех пяти неавтоматических клеток; True если все v_2 чётны"""
    vals = cells_int(mm, nn, pp, qq)
    return all(v != 0 and (v.valuation(2) % 2 == 0) for v in [vals[0], vals[2], vals[4], vals[6], vals[8]])

print()
print("="*100)
print("ЧАСТЬ 3. Полная 2-адическая классификация (m нечётно, n чётно)")
print("="*100)

print("""
Пусть m нечётно, n чётно, p,q оба нечётны (часть 2).  Нечётное X — квадрат в Z_2  <=>  X = 1 (mod 8).
Считаем вычеты (m^2 = 1 mod 8, p^2 = q^2 = 1 mod 8):

  F0 = m^2 q^2 + n^2 p^2 = 1 + n^2   (mod 8)
  F8 = n^2 q^2 + m^2 p^2 = n^2 + 1   (mod 8)

  Если n = 2 (mod 4): n^2 = 4 (mod 32)  =>  F0 = F8 = 5 (mod 8)  => НЕ квадраты.
  ПРЕПЯТСТВИЕ ЕСТЬ, но оно убивает n = 2 (mod 4), и убивает уже БЕЛЫЕ клетки F0, F8,
  а не красные.  Это условие на семь квадратов, не на девять.

  Если 4 | n: n^2 = 0 (mod 16)  =>  F0 = F8 = 1 (mod 8) АВТОМАТИЧЕСКИ (препятствия нет),
  m^2+n^2 = 1 (mod 8), поэтому
      F4 = (m^2+n^2)(p^2+q^2)/2 = (p^2+q^2)/2  (mod 8),
  а (p^2+q^2)/2 = 1 (mod 8)  <=>  p^2 = q^2 (mod 16)  <=>  t = p/q = ±1 (mod 8).
  Наконец 2mn pq = 0 (mod 8) (так как 4 | n), значит
      c2 = c6 = F4  (mod 8).
  ВЫВОД: при 4|n красные клетки сравнимы с F4 по модулю 8, и как только центр F4 — квадрат
  (что уже требуется для семи квадратов), КРАСНЫЕ КЛЕТКИ АВТОМАТИЧЕСКИ = 1 (mod 8),
  то есть квадраты в Z_2.  2-адического препятствия НЕТ.
""")

def is_sq2(x):
    """x in QQ, x != 0: квадрат ли в Q_2"""
    x = QQ(x)
    if x == 0: return True
    v = x.valuation(2)
    if v % 2: return False
    u = x / 2^v
    return (u.numerator() * u.denominator()) % 8 == 1

# --- полный перебор по вычетам mod 2^k ---------------------------------------
print("Полный перебор по вычетам: для m нечёт., n = 0 mod 4, p,q нечёт. ищем, при каких")
print("t = p/q (mod 2^k) ВСЕ ПЯТЬ клеток F0,F4,F8,c2,c6 — квадраты в Z_2.")
print()
for K in [3,4,5,6,7,8,9,10]:
    M = 2^K
    good_t = set()
    for mm in range(1, M, 2):
        for nn in range(0, M, 4):
            if gcd(mm, nn) != 1 and nn != 0: continue
            for tt in range(1, M, 2):
                # берём q=1, p=tt (t 2-адическая единица)
                vals = cells_int(mm, nn, tt, 1)
                if all(is_sq2(vals[i]) for i in [0,2,4,6,8]):
                    good_t.add(tt % 8)
    print(f"  2^{K}: допустимые t mod 8 = {sorted(good_t)}   (пусто означало бы препятствие)")

print()
print("[доказано] Допустимое множество t — ровно t = ±1 (mod 8); оно НЕПУСТО и открыто.")
print("           Никакого дополнительного условия по модулю 16, 32, ... не возникает:")
print("           для нечётного X условие «квадрат в Z_2» — ровно X = 1 (mod 8), больше ничего.")

print()
print("="*100)
print("ЧАСТЬ 4. Конкретные оставшиеся пары: явные 2-адические точки")
print("="*100)

pairs = [(13,8),(15,8),(19,16),(16,5),(15,1),(19,5),(11,4)]
Q2 = Qp(2, 60)
for (a,b) in pairs:
    # приводим к виду m нечётно, n чётно (если есть чётное)
    if a % 2 == 0: mm, nn = b, a
    else:          mm, nn = a, b
    parity = "оба нечётны" if nn % 2 else (f"n = {nn}, v_2(n) = {ZZ(nn).valuation(2)}")
    hits = []
    for pp in range(1, 400, 2):
        for qq in range(1, 400, 2):
            if gcd(pp,qq) != 1: continue
            vals = cells_int(mm, nn, pp, qq)
            if all(is_sq2(vals[i]) for i in [0,2,4,6,8]):
                hits.append((pp,qq)); break
        if len(hits) >= 3: break
    if hits:
        pp,qq = hits[0]
        vals = cells_int(mm,nn,pp,qq)
        roots = []
        for i in [0,2,4,6,8]:
            r = Q2(vals[i]).sqrt()
            roots.append(r)
            assert (r^2 - Q2(vals[i])).valuation() >= 55
        print(f"  ({a},{b}) [{parity}]: 2-адическая точка есть, напр. t = {hits[0][0]}/{hits[0][1]}")
        print(f"        клетки mod 8: F0={vals[0]%8} c2={vals[2]%8} F4={vals[4]%8} c6={vals[6]%8} F8={vals[8]%8};"
              f" все корни в Z_2 существуют (проверено до 2^-55)")
    else:
        print(f"  ({a},{b}) [{parity}]: 2-адических точек с t = p/q, p,q <= 400 НЕ найдено")

print()
print("Плотность допустимых t в Z_2^*: t = ±1 (mod 8) — это 2 класса из 4 нечётных, т.е. 1/2 единиц.")

print()
print("="*100)
print("ЧАСТЬ 5. Контроль: где 2-адическое препятствие ДЕЙСТВИТЕЛЬНО есть")
print("="*100)

print("Проверяем все 127 взаимно простых пар m,n <= 20 — есть ли хоть одно t (p,q <= 200) с пятью")
print("2-адическими квадратами. Пустота = 2-адическое препятствие на ДЕВЯТЬ клеток.")
blocked, okpairs = [], []
for a in range(2,21):
    for b in range(1,a):
        if gcd(a,b) != 1: continue
        mm, nn = (b,a) if a % 2 == 0 else (a,b)
        found = None
        for pp in range(0, 200):
            for qq in range(1, 200):
                if gcd(pp,qq) != 1: continue
                vals = cells_int(mm,nn,pp,qq)
                if all(v != 0 for v in vals) and all(is_sq2(vals[i]) for i in [0,2,4,6,8]):
                    found = (pp,qq); break
            if found: break
        (okpairs if found else blocked).append((a,b))
print(f"  пар без 2-адической точки (препятствие):  {len(blocked)}")
print(f"  пар с 2-адической точкой (нет препятствия): {len(okpairs)}")
print(f"  заблокированные: {blocked}")
print()
print("Классификация заблокированных по чётности:")
for (a,b) in blocked:
    ev = a if a%2==0 else (b if b%2==0 else None)
    tag = f"чётное = {ev}, v_2 = {ZZ(ev).valuation(2)}" if ev else f"оба нечётны, m mod 8 = {a%8}, n mod 8 = {b%8}"
    print(f"    ({a},{b}): {tag}")

print()
print("Оставшиеся четыре пары проекта:")
for (a,b) in [(13,8),(15,8),(16,5),(19,16)]:
    ev = a if a%2==0 else b
    print(f"    ({a},{b}): чётное = {ev}, v_2 = {ZZ(ev).valuation(2)}  ->  "
          + ("ЗАБЛОКИРОВАНА 2-адически" if (a,b) in blocked else "2-адически РАЗРЕШИМА, препятствия нет"))

print()
print("="*100)
print("ИТОГ")
print("="*100)
print("""
[доказано] Полная 2-адическая классификация G1 (m нечётно, n чётно, gcd = 1):
   (i)  t обязан быть 2-адической единицей (иначе v_2(F4) нечётно);
   (ii) n = 2 (mod 4) невозможно: F0 = F8 = 5 (mod 8);  -- это препятствие УЖЕ на семь квадратов;
   (iii) при 4 | n: F0 = F8 = 1 (mod 8) автоматически; F4 = c2 = c6 (mod 8), и условие ровно одно:
         t = ±1 (mod 8).  Оно выполнимо.
[доказано] Следовательно ПРИ ЧЁТНОМ n 2-адического препятствия на красные клетки НЕТ:
   красные клетки сравнимы с центром по модулю 8, а центр обязан быть = 1 (mod 8) уже
   на уровне семи квадратов.  Красные клетки 2-адически «бесплатны».
[следствие] Пары (13,8), (15,8), (19,16) (у всех 4 | n) 2-адически НЕ закрываются.  Ни одна из них.
""")
