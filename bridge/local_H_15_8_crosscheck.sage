# local_H_15_8_crosscheck.sage
#
# НЕЗАВИСИМАЯ перепроверка выводов local_H_15_8.sage для пары G1 (m,n) = (15,8).
# Намеренно НЕ использует рекурсивный решатель disc_solvable из основного скрипта:
# все вердикты получаются либо из тождеств над Q, либо из встроенной
# арифметики Sage в Qp(p) (другой код-путь).
#
# Запуск: sage /home/kep/magicKube/bridge/local_H_15_8_crosscheck.sage

print("="*78)
print("CROSSCHECK: локальная разрешимость H : Y^2 = F0*F4*F8, (m,n) = (15,8)")
print("="*78)

R = PolynomialRing(QQ, 't'); t = R.gen()
m, n = 15, 8
assert gcd(m, n) == 1
s  = QQ(m**2 + n**2)/2
F0 = m**2 + n**2*t**2
F4 = s*(1 + t**2)
F8 = n**2 + m**2*t**2
f  = F0*F4*F8

# --- 1. Модель: сверка с формулами из постановки задачи ----------------------
print("\n[A] СВЕРКА МОДЕЛИ")
print("  s  =", s, " (= (m^2+n^2)/2 = 289/2)")
print("  F0 =", F0, "   F4 =", F4, "   F8 =", F8)
b = s*m**2*n**2
a = QQ(m**2)/n**2 + 1 + QQ(n**2)/m**2
assert f == b*(t**6 + a*t**4 + a*t**2 + 1)
print("  f == b(t^6 + a t^4 + a t^2 + 1) с b =", b, ", a =", a, ": OK")
for tt in [QQ(0), QQ(1), QQ(-1), QQ(2), QQ(-3), QQ(5)/7, QQ(-11)/6, QQ(100)/3]:
    assert f(tt) == (m**2+n**2*tt**2) * s * (1+tt**2) * (n**2+m**2*tt**2)
print("  поточечная сверка f(t) в 8 значениях t: OK")
assert f.degree() == 6 and f.is_squarefree()
print("  deg f = 6, f бесквадратен => H гладкая рода 2. Корни f:", f.roots(CC, multiplicities=False))

# целочисленная модель, Q-изоморфная H:  g = 2*F0*(1+t^2)*F8,  f/g = (17/2)^2
g  = R(2*(m**2+n**2*t**2)*(1+t**2)*(n**2+m**2*t**2))
gZ = PolynomialRing(ZZ, 't')(g)
print("  g =", gZ, "  (f/g =", f/g, "= (17/2)^2, квадрат в Q* => Q-изоморфизм Y -> (17/2)Y)")
assert (f/g).is_square()

# --- 2. ГЛАВНОЕ: ГЛОБАЛЬНАЯ рациональная точка ------------------------------
print("\n[B] ГЛОБАЛЬНАЯ ТОЧКА (решает всё)")
print("  Ключ: m^2+n^2 = 15^2+8^2 = 289 = 17^2 -- ПОЛНЫЙ КВАДРАТ (пифагорова пара).")
print("  При t = 1:  F0 = m^2+n^2 = %s, F4 = 2s = m^2+n^2 = %s, F8 = n^2+m^2 = %s"
      % (F0(1), F4(1), F8(1)))
v1 = f(QQ(1))
print("  f(1) = (m^2+n^2)^3 = 289^3 = %s = 17^6 = (17^3)^2 = 4913^2 ; квадрат: %s"
      % (v1, v1.is_square()))
assert v1 == 17**6 and v1.is_square() and sqrt(v1) == 4913
print("  То же при t = -1 (f чётна): f(-1) =", f(QQ(-1)))
assert f(QQ(-1)) == v1
print("  На целой модели: g(1) = %s = %s^2" % (g(QQ(1)), sqrt(g(QQ(1)))))
assert g(QQ(1)) == 578**2
print("  => (t,Y) = (1, 4913), (1,-4913), (-1, +-4913) ∈ H(Q).  H(Q) ≠ ∅. [ДОКАЗАНО]")
print("  => Для ЛЮБОГО места v поля Q вложение Q -> Q_v даёт точку в H(Q_v).")
print("     H(Q_v) ≠ ∅ для всех v без исключения. ПРЕПЯТСТВИЙ НЕТ. [ДОКАЗАНО]")

# --- 3. Вещественное место (независимо от [B]) ------------------------------
print("\n[C] ВЕЩЕСТВЕННОЕ МЕСТО (независимый аргумент)")
print("  F0 = 225 + 64t^2 >= 225 > 0; F4 = (289/2)(1+t^2) >= 289/2 > 0;")
print("  F8 = 64 + 225t^2 >= 64 > 0  =>  f(t) >= 225*(289/2)*64 > 0 для всех t ∈ R.")
print("  Вещественных корней у f:", len(f.roots(RR)), "(=0, подтверждает)")
print("  min f по сетке t=k/100, |k|<=20000:",
      min([f(QQ(k)/100) for k in range(-20000, 20001)]))
print("  => H(R) ≠ ∅ (и вся вещественная кривая непуста: два овала/компоненты). [ДОКАЗАНО]")

# --- 4. Плохие простые: дискриминант ---------------------------------------
print("\n[D] ДИСКРИМИНАНТ И ПЛОХИЕ ПРОСТЫЕ")
disc = gZ.discriminant()
print("  disc(g) =", factor(disc))
bad = sorted(set([p for p, e in factor(disc)]) |
             set([p for p, e in factor(gZ.leading_coefficient())]) | {2})
print("  кандидаты в плохие простые (| disc, | старш.коэф, плюс 2):", bad)

# --- 5. Явные p-адические точки через СОБСТВЕННУЮ арифметику Sage в Qp ------
print("\n[E] ЯВНЫЕ ТОЧКИ В H(Q_p) -- проверка встроенным Qp(p).is_square()")
print("    (другой код-путь, чем рекурсивный решатель основного скрипта)")
print("    %-5s %-14s %-22s %-6s %-9s %s" % ("p", "плохое?", "свидетель g(t)", "v_p", "ед.часть", "квадрат в Q_p"))
allp = sorted(set(bad) | set(primes(2, 100)))
witness = {}
for p in allp:
    K = Qp(p, 80)
    found = None
    # ищем свидетеля среди простых значений t; t=1 обязан сработать всегда (глоб. точка)
    for tt in [QQ(1), QQ(0), QQ(2), QQ(3), QQ(1)/2, QQ(1)/3, QQ(5), QQ(7)]:
        val = g(tt)
        if val != 0 and K(val).is_square():
            found = (tt, val); break
    assert found is not None, "не нашли свидетеля при p=%s" % p
    tt, val = found
    vp = QQ(val).valuation(p)
    unit = QQ(val)/QQ(p)**vp
    witness[p] = (tt, val)
    print("    %-5d %-14s t=%-6s g=%-12s %-6d %-9s %s"
          % (p, "ПЛОХОЕ" if p in bad else "хорошее", tt, val, vp,
             str(unit)[:9], K(val).is_square()))
print("    Все %d простых (включая ВСЕ плохие %s) дали точку в H(Q_p). [ДОКАЗАНО]"
      % (len(allp), bad))

# ручная сверка ключевых случаев (арифметика проверяется глазами)
print("\n    Ручная сверка: g(1) = 334084 = 578^2 -- КВАДРАТ В Z,")
print("    поэтому он квадрат в каждом Q_p и в R. Иных вычислений для вывода не нужно.")
assert ZZ(g(QQ(1))).is_square()

# --- 6. Точки на бесконечности ---------------------------------------------
print("\n[F] ТОЧКИ НА БЕСКОНЕЧНОСТИ (гладкая модель рода 2)")
lc = gZ.leading_coefficient()
print("  старший коэффициент g:", lc, "=", factor(lc), "; квадрат в Q?", ZZ(lc).is_square())
sf = ZZ(lc).squarefree_part()
print("  бесквадратная часть:", sf, " => обе точки на бесконечности рациональны над Q_v")
print("  тогда и только тогда, когда %s -- квадрат в Q_v; иначе они сопряжены над Q_v(sqrt %s)." % (sf, sf))
print("  (то же для исходной модели f: старш.коэф. b = %s, бесквадр. часть = %s)"
      % (b, ZZ(b.numerator()*b.denominator()).squarefree_part()))
assert ZZ(b.numerator()*b.denominator()).squarefree_part() == sf
print("  R: 2 > 0 -- квадрат в R => ДВЕ вещественные точки на бесконечности.")
inf_ok = []
for p in allp:
    ok = Qp(p, 60)(sf).is_square()
    inf_ok.append((p, ok))
print("  p, где 2 -- квадрат в Q_p (т.е. точки на бесконечности Q_p-рациональны):",
      [p for p, ok in inf_ok if ok])
print("  p, где 2 НЕ квадрат (точки на бесконечности сопряжены, Q_p-точек на них нет):",
      [p for p, ok in inf_ok if not ok])
print("  ВАЖНО: это НЕ препятствие -- аффинных точек над каждым Q_p достаточно (см. [E]),")
print("  а глобальная точка (1,4913) аффинна. [ДОКАЗАНО]")

# --- 7. Контроль: точка вырожденная ----------------------------------------
print("\n[G] КОНТРОЛЬ СМЫСЛА: найденная точка вырождена для исходной задачи")
print("  t = 1  =>  F0 = F4 = F8 = 289 = 17^2,  u0 = u4 = u8 = 17.")
print("  Три клетки магического квадрата равны => НЕ даёт квадрата из РАЗЛИЧНЫХ квадратов.")
print("  Подъём на C (род 5) существует (все три F_i -- квадраты), но решение тривиально.")
print("  Вывод для проекта: локальных препятствий у H нет, отсеивать (15,8) нужно")
print("  глобальными методами (Шабати-Коулмен / Кummer), а не локальными.")

print("\n" + "="*78)
print("ИТОГ CROSSCHECK (15,8):")
print("  H(R) ≠ ∅                        : ДА  [доказано]")
print("  H(Q_p) ≠ ∅ для всех p (все плохие 2,3,5,7,17,23 + все p<100): ДА [доказано]")
print("  Причина: H(Q) ≠ ∅ -- глобальная точка (t,Y)=(1,4913), т.к. 15^2+8^2 = 17^2.")
print("  ЛОКАЛЬНОГО ПРЕПЯТСТВИЯ НЕТ. obstruction_found = FALSE")
print("="*78)
