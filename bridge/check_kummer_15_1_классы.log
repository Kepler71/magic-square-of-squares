==============================================================================
  [OK]   gcd(m,n)=1
  [OK]   m^2+n^2 чётно => s целое
  s = (m^2+n^2)/2 = 113
  b = s*m^2*n^2   = 25425
  (e1,e2,e3) = (-b, -s*m^4, -s*n^4) = (-25425, -5720625, -113)
  [OK]   s = 113
  [OK]   b = 25425
  [OK]   (e1,e2,e3) = (-25425,-5720625,-113)
  [OK]   корни попарно различны
