# -*- coding: utf-8 -*-
# СТАТУС: рабочий код + контроли (предложение замены эвристики на решающую процедуру)
# ДЛЯ: Claude, Codex, пользователь
# ИТОГ: сертифицированный поиск вещественной локальной точки квартики; исчерпания нет — есть решение
# ОТМЕНЯЕТ: ничего; кандидат на замену ветки RealPlace в descent/ctp_quartic.sage (стр. ~1247-1299)
# ПРОВЕРЕНО: контрпример Codex 1e-40-(x^2-2)^2; квартика n79 i=2 при r -> -sqrt(7); (11,4) и (19,16)
# ЧИТАТЬ ДАЛЬШЕ, ЕСЛИ: правите local_point или доверяете строке «нет вещественной точки»
#
# Запуск:  sage /home/kep/magicKube/bridge/real_point_certified.sage
#
# ИДЕЯ. Вещественное место — единственное, где вопрос «есть ли локальная точка» РАЗРЕШИМ точно
# и дёшево: знак вещественной квартики постоянен на каждом интервале между её вещественными
# корнями, корней не больше четырёх, а корни изолируются точно в AA (вещественные алгебраические
# числа с сертифицированными интервалами). Поэтому эвристический поиск здесь не нужен вообще.
#
# Процедура (возвращает точку ИЛИ доказательство отсутствия — третьего исхода нет):
#   1. G(x) = sigma(g1)(x,1) с коэффициентами в AA (точно, без RealField);
#   2. точная изоляция вещественных корней G в AA;
#   3. в каждом из <= 5 открытых интервалов знакопостоянства берётся рациональная точка,
#      лежащая внутри ДОКАЗАННО (по двоичным границам сертифицированного интервала корня);
#   4. знак g1(q,1) проверяется ТОЧНО в k (сравнение в AA), не в плавающей арифметике;
#   5. запрет gamma(x,z) != 0 обходится тем, что в каждом интервале берётся три разные точки,
#      а gamma — квадратичная форма и обнуляется не более чем в двух точках P^1;
#   6. отдельно разбирается точка (1:0): её знак — знак старшего коэффициента.
#   Если плюса нет ни в одном интервале и старший коэффициент отрицателен, то sigma(g1) <= 0
#   всюду: вещественной точки НЕТ, и это теорема, а не исчерпание поиска.
#
# ВАЖНО ПРО СТАТУС ВЫХОДА "НЕТ ТОЧКИ". Квартики в CTP приходят из классов Sel^2, то есть накрытия
# всюду локально разрешимы ПО ПОСТРОЕНИЮ. Значит исход «точки нет» означает ошибку выше по потоку
# (не тот класс, не та квартика, потеря масштаба), а не арифметический факт про кривую.
# Поэтому он поднимается отдельным исключением ELSViolated, а не молча трактуется как препятствие.

import functools
print = functools.partial(print, flush=True)


class ELSViolated(RuntimeError):
    """Доказано: sigma(g1) <= 0 на всей P^1(R). Для квартики из Sel^2 это невозможно — ищите ошибку выше."""


def _exact_coeffs(g1, k, emb):
    """коэффициенты sigma(g1) как точные элементы AA"""
    if emb is None:
        return [AA(QQ(c)) for c in g1]
    return [AA(emb(k(c))) for c in g1]


def _rat_in(lo, hi, how_many=3, prec0=64):
    """рациональные точки СТРОГО внутри (lo, hi); lo/hi — AA или None (бесконечность).
       Строгость доказана двоичными границами сертифицированного интервала."""
    if lo is None and hi is None:
        return [QQ(0), QQ(1), QQ(-1)]
    prec = prec0
    while True:
        RIFp = RealIntervalField(prec)
        if lo is None:
            b = QQ(RIFp(hi).lower().exact_rational())
            return [b - 1, b - 2, b - 3]
        if hi is None:
            a = QQ(RIFp(lo).upper().exact_rational())
            return [a + 1, a + 2, a + 3]
        a = QQ(RIFp(lo).upper().exact_rational())
        b = QQ(RIFp(hi).lower().exact_rational())
        if a < b:
            w = b - a
            out = [a + w / 2, a + w / 4, a + 3 * w / 4][:how_many]
            # косметика + перепроверка: простейшая рациональная в зазоре, с ТОЧНОЙ проверкой
            # строгого вхождения (сравнение в AA завершается и не приближает)
            try:
                s = QQ(RIFp(a, b).simplest_rational())
                if AA(s) > lo and AA(s) < hi:
                    out = [s] + out
            except Exception:
                pass
            return out
        prec *= 2
        if prec > 2 ^ 20:
            raise RuntimeError("не удалось отделить корни двоичными границами — проверьте сепарабельность")


def certified_real_point(g1, gam, k=QQ, emb=None, verbose=False):
    """ (x, z) в k^2 с sigma(g1(x,z)) > 0 и gam(x,z) != 0, ЛИБО ELSViolated с доказательством.
        g1 — список из 5 коэффициентов (старший первым), gam — список из 3. """
    def qev(x, z):
        return g1[0] * x ^ 4 + g1[1] * x ^ 3 * z + g1[2] * x ^ 2 * z ^ 2 + g1[3] * x * z ^ 3 + g1[4] * z ^ 4

    def gev(x, z):
        return gam[0] * x ^ 2 + gam[1] * x * z + gam[2] * z ^ 2

    def sgn(a):
        a = k(a)
        if a == 0:
            return 0
        s = AA(QQ(a)) if emb is None else AA(emb(a))
        return 1 if s > 0 else -1

    # (1:0) — точка на бесконечности; знак = знак старшего коэффициента
    if g1[0] != 0 and sgn(g1[0]) > 0 and gev(k(1), k(0)) != 0:
        if verbose:
            print("   сертифицировано: (1:0), старший коэффициент положителен")
        return k(1), k(0)

    C = _exact_coeffs(g1, k, emb)
    Rx = PolynomialRing(AA, 'x'); xx = Rx.gen()
    G = sum(C[j] * xx ^ (4 - j) for j in range(5))
    if G == 0:
        raise RuntimeError("sigma(g1) тождественно нуль — вырожденный вход")
    rts = sorted(G.roots(AA, multiplicities=False))
    if verbose:
        print("   вещественных корней sigma(g1): %d" % len(rts))
    bounds = [(None, rts[0])] + [(rts[i], rts[i + 1]) for i in range(len(rts) - 1)] + [(rts[-1], None)] \
        if rts else [(None, None)]
    for (lo, hi) in bounds:
        for q in _rat_in(lo, hi):
            x = k(q); z = k(1)
            v = qev(x, z)
            if v != 0 and sgn(v) > 0 and gev(x, z) != 0:
                if verbose:
                    print("   сертифицировано: x = %s (внутри интервала знакопостоянства)" % q)
                return x, z
    # ни один интервал не дал плюса и (1:0) тоже — знак <= 0 всюду. Это ДОКАЗАТЕЛЬСТВО.
    raise ELSViolated(
        "доказано: sigma(g1) <= 0 на всей P^1(R) (знак проверен точно в каждом из %d интервалов "
        "знакопостоянства и на бесконечности). Для квартики из Sel^2 это невозможно; ищите ошибку выше." % len(bounds))


# ======================================================================== контроли
if True:
    print("=" * 78)
    print("КОНТРОЛЬ 1. Контрпример Codex: g(x) = 10^-40 - (x^2-2)^2, gamma = x^2 + z^2")
    print("=" * 78)
    # g(x) = -x^4 + 4x^2 + (1e-40 - 4);  как бинарная квартика при z = 1
    e = QQ(1) / 10 ^ 40
    g_codex = [QQ(-1), QQ(0), QQ(4), QQ(0), e - 4]
    gam_codex = [QQ(1), QQ(0), QQ(1)]
    x, z = certified_real_point(g_codex, gam_codex, k=QQ, emb=None, verbose=True)
    v = g_codex[0]*x^4 + g_codex[1]*x^3*z + g_codex[2]*x^2*z^2 + g_codex[3]*x*z^3 + g_codex[4]*z^4
    print("   точка: (%s : %s),  g = %s" % (x, z, v))
    print("   g > 0 (точно в QQ):", v > 0)
    print("   точка Codex 367296043199/259717522849 тоже годится:",
          (lambda t: (g_codex[0]*t^4 + g_codex[2]*t^2 + g_codex[4]) > 0)(QQ(367296043199)/QQ(259717522849)))

    print()
    print("=" * 78)
    print("КОНТРОЛЬ 2. Настоящая квартика n79, ядро i=2, место real -2.6458 (=-sqrt(7))")
    print("            (именно на ней старый код напечатал «нет вещественной локальной точки»)")
    print("=" * 78)
    k7 = QuadraticField(7, 'r'); r = k7.gen()
    g_n79 = [108567823936613224192794318332400*r - 2585434076908306143063615234351300/13,
             -835182673116765383639667600108100*r + 2377990257795405994151898824171520,
             3090973567349595988804021472294100*r - 8057735235317727557383935375560880,
             -4818782982397077432825102640924300*r + 12787462247658684252178647931482960,
             2847373083041117699373511528149100*r - 7528898314370252163965486708251500]
    gam_dummy = [k7(1), k7(0), k7(1)]          # gamma настоящая здесь не нужна: тест на поиск точки
    for embv in k7.embeddings(AA):
        nm = "r -> %s" % embv(r).n(20)
        print(" вложение %s" % nm)
        t0 = walltime()
        x, z = certified_real_point(g_n79, gam_dummy, k=k7, emb=embv, verbose=True)
        v = (g_n79[0]*x^4 + g_n79[1]*x^3*z + g_n79[2]*x^2*z^2 + g_n79[3]*x*z^3 + g_n79[4]*z^4)
        print("   точка (%s : %s), sigma(g1) > 0: %s, время %.2f c" % (x, z, AA(embv(v)) > 0, walltime(t0)))

    print()
    print("=" * 78)
    print("КОНТРОЛЬ 3. Отрицательный случай: квартика БЕЗ вещественных точек (должна быть теорема)")
    print("=" * 78)
    g_neg = [QQ(-1), QQ(0), QQ(0), QQ(0), QQ(-1)]       # -x^4 - z^4 < 0 всюду
    try:
        certified_real_point(g_neg, [QQ(1), QQ(0), QQ(1)], k=QQ, emb=None, verbose=True)
        print("   ОШИБКА: должна была быть ELSViolated")
    except ELSViolated as ex:
        print("   ELSViolated (ожидаемо):", str(ex)[:120])

    print()
    print("=" * 78)
    print("КОНТРОЛЬ 4. Принятые сертификаты: (11,4) и (19,16) — точка обязана найтись сразу")
    print("=" * 78)
    g_11_4 = [QQ(-31441500), QQ(-3320880), QQ(14820660), QQ(1496040), QQ(30825)]
    gam_11_4 = [QQ(-3070869), QQ(680213), QQ(-47903)]
    x, z = certified_real_point(g_11_4, gam_11_4, verbose=True)
    print("   (11,4): (%s : %s)  — сертификат использует (0:1), g = 30825 > 0" % (x, z))
    g_19_16 = [QQ(61221825), QQ(-479668140), QQ(13604850), QQ(53296460), QQ(755825)]
    gam_19_16 = [QQ(-191209518), QQ(29410539), QQ(-35796830)]
    x, z = certified_real_point(g_19_16, gam_19_16, verbose=True)
    print("   (19,16): (%s : %s) — сертификат использует (1:0), g = 61221825 > 0" % (x, z))

    print()
    print("ИТОГ: у процедуры два исхода — точка с точной проверкой знака либо ДОКАЗАННОЕ отсутствие.")
    print("      Исхода «поиск исчерпан» нет вообще.")

# НЕ ДЕЛАТЬ:
# - не переносить эту процедуру на конечные места: там знакопостоянство не работает,
#   нужен либо разбор по шайбам (как bridge/local_H_19_5.sage), либо честный третий исход;
# - не считать ELSViolated локальным препятствием: для квартики из Sel^2 это сигнал об ошибке выше;
# - не заменять точное сравнение в AA на RealField: ширина интервала бывает 5e-13 при коэффициентах 1e34.
