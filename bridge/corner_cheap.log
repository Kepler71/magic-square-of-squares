  где достигается (пара -> (выживших, p)): [((2, 1), (2, 3)), ((3, 1), (2, 3)), ((3, 2), (2, 3)), ((4, 1), (2, 3)), ((4, 3), (2, 3)), ((5, 1), (2, 3)), ((5, 2), (2, 3)), ((5, 3), (2, 3)), ((5, 4), (2, 3)), ((6, 1), (2, 3))]

