# -*- coding: utf-8 -*-
# ============================================================================================
# ПРЯМАЯ 2-АДИЧЕСКАЯ АТАКА НА G1.  Вопрос: верно ли, что «при чётном n красные клетки G1
# не могут быть квадратами», и доказуемо ли это 2-адически на ВСЁМ G1?
#
# ОТВЕТ (см. ИТОГ в конце): НЕТ.  2-адическое препятствие есть ровно при n = 2 (mod 4)
# (и оно убивает уже БЕЛЫЕ клетки, не красные); при 4 | n препятствия НЕТ ВООБЩЕ.
# Красные клетки не добавляют к p=2 ни одного условия — доказано и проверено перебором.
# Пары (13,8), (15,8), (19,16), (16,5) 2-адически НЕ закрываются.
#
# Всё выводится с нуля: Сегре -> магичность -> девять клеток -> v_2 и вычеты.
# Дополнительно: идентифицирована рекуррента Весоловского и восстановлен механизм
# теоремы Бойера «при чётном n» — это НЕ наш параметр n, а индекс рекурренты.
#
# Предыдущая версия этого файла сохранена как even_n_2адика_v1.sage (выводы совпадают).
# Запуск:  sage /home/kep/magicKube/bridge/even_n_2адика.sage
# ============================================================================================
import functools, random
from fractions import Fraction as Fr
print = functools.partial(print, flush=True)

SEP = "=" * 98

# --------------------------------------------------------------------------------------------
print(SEP); print("ЧАСТЬ 1. Девять клеток G1 выводятся из магичности (символически, с нуля)"); print(SEP)
# --------------------------------------------------------------------------------------------
R = PolynomialRing(QQ, ['m','n','p','q']); m, n, p, q = R.gens()

# Сегре-параметризация квадрики P^2+Q^2 = R^2+S^2 = 2c (BREMNER16 §2.2):
P_, Q_, Rr, S_ = m*p + n*q,  m*q - n*p,  m*p - n*q,  m*q + n*p
c1, c7, c3, c5 = P_^2, Q_^2, Rr^2, S_^2          # G1: полные РЁБЕРНЫЕ пары {c1,c7} и {c3,c5}
c4 = (c1 + c7)/2
assert c4 == (c3 + c5)/2, "пары несовместны"

# магичность однозначно достраивает остальные четыре клетки:
#   диагонали  ->  c8 = 2c4 - c0,  c6 = 2c4 - c2
#   столбец 0  ->  c0 + c3 + c6 = 3c4  =>  c2 = c0 + c3 - c4
#   строка 0   ->  c0 + c1 + c2 = 3c4  =>  c0 = 2c4 - (c1+c3)/2
c0 = 2*c4 - (c1 + c3)/2
c2 = c0 + c3 - c4
c8 = 2*c4 - c0
c6 = 2*c4 - c2
cells = [c0,c1,c2,c3,c4,c5,c6,c7,c8]
lines = [(0,1,2),(3,4,5),(6,7,8),(0,3,6),(1,4,7),(2,5,8),(0,4,8),(2,4,6)]
for L in lines: assert sum(cells[i] for i in L) == 3*c4, f"линия {L}"
print("[доказано] все 8 линий = 3*c4 при ЛЮБЫХ m,n,p,q.")

F0 = m^2*q^2 + n^2*p^2
F4 = (m^2 + n^2)*(p^2 + q^2)/2
F8 = n^2*q^2 + m^2*p^2
assert (c0, c4, c8) == (F0, F4, F8)
assert c2 == F4 - 2*m*n*p*q and c6 == F4 + 2*m*n*p*q
assert 2*c2 == c3 + c7 and 2*c6 == c1 + c5
print("""[доказано] Девять клеток G1 (t = p/q, всё умножено на q^2):

      c0 = m^2 q^2 + n^2 p^2        c1 = (mp + nq)^2             c2 = F4 - 2mn pq     <- КРАСНАЯ
      c3 = (mp - nq)^2              c4 = F4 = (m^2+n^2)(p^2+q^2)/2                    <- центр
      c5 = (mq + np)^2              c6 = F4 + 2mn pq   <- КРАСНАЯ  c7 = (mq - np)^2
      c8 = n^2 q^2 + m^2 p^2

   Автоматические квадраты: c1, c3, c5, c7.
   БЕЛЫЕ условия (семь квадратов, кривая C рода 5): c0 = F0, c4 = F4, c8 = F8 — квадраты.
   КРАСНЫЕ условия (девять квадратов): c2, c6 — квадраты.
   Тождества:  c2 + c6 = 2 F4,   c2 c6 = F4^2 - 4 m^2 n^2 p^2 q^2,
               2 c2 = (mp-nq)^2 + (mq-np)^2,  2 c6 = (mp+nq)^2 + (mq+np)^2.
   Дискриминант формы c2(p,q) по p/q равен 4m^2n^2 - (m^2+n^2)^2 = -(m^2-n^2)^2 < 0,
   значит c2, c6 > 0 всегда: вещественного препятствия нет.""")

def CELLS(mm, nn, pp, qq):
    return [QQ(c(mm, nn, pp, qq)) for c in cells]

for _ in range(300):
    mm, nn, pp, qq = [random.randrange(-40, 41) for _ in range(4)]
    v = CELLS(mm, nn, pp, qq)
    assert all(sum(v[i] for i in L) == 3*v[4] for L in lines)
print("[проверено численно] 300 случайных (m,n,p,q): магичность.")

# --------------------------------------------------------------------------------------------
print(); print(SEP); print("ЧАСТЬ 2. Полная 2-адическая классификация — доказательство"); print(SEP)
# --------------------------------------------------------------------------------------------
print("""
Нечётное X — квадрат в Q_2  <=>  X = 1 (mod 8).  Ни mod 16, ни mod 32 НИЧЕГО не добавляют:
квадраты нечётных чисел в Z/2^k при k>=3 — это ровно все вычеты 1 (mod 8).
Поэтому единственный рычаг — совместные соотношения между клетками, а не отдельные клетки.

Пусть gcd(m,n) = 1, t = p/q в несократимом виде.

СЛУЧАЙ A: m нечётно, n чётно (n = 2^v n', v >= 1, n' нечётно).  Тогда m^2+n^2 нечётно.
  A1. Если p,q разной чётности, то p^2+q^2 нечётно и v_2(F4) = -1 — не квадрат.
      ЗНАЧИТ p, q ОБА НЕЧЁТНЫ, т.е. t — 2-адическая единица.  Тогда p^2 = q^2 = 1 (mod 8),
      W := (p^2+q^2)/2 — нечётное целое, и все пять клеток F0,c2,F4,c6,F8 — НЕЧЁТНЫЕ ЦЕЛЫЕ.
  A2. v = 1 (n = 2 mod 4):  n^2 = 4 (mod 32)  =>  F0 = m^2q^2 + n^2p^2 = 1 + 4 = 5 (mod 8).
      ПРЕПЯТСТВИЕ.  Но оно на БЕЛОЙ клетке F0 (и F8), то есть уже на СЕМИ квадратах.
      (Заодно 2mn pq = 4 (mod 8), так что и c2 = F4 + 4 (mod 8) — но это следствие, не причина.)
  A3. v >= 2 (4 | n):  n^2 = 0 (mod 16)  =>  F0 = F8 = 1 (mod 8) АВТОМАТИЧЕСКИ;
      m^2+n^2 = 1 (mod 8)  =>  F4 = W (mod 8);
      2mn pq = 2^{v+1} m n' pq = 0 (mod 8)  =>  c2 = c6 = F4 (mod 8).
      Единственное условие:  W = 1 (mod 8)  <=>  p^2 = q^2 (mod 16)  <=>  t = ±1 (mod 8).
      Оно ВЫПОЛНИМО (например t = 1).  2-АДИЧЕСКОГО ПРЕПЯТСТВИЯ НЕТ.

СЛУЧАЙ B: m, n оба нечётны.  s = (m^2+n^2)/2 — целое, s = 1 (mod 4).
  B1. Если p,q оба нечётны, то F0 = m^2q^2 + n^2p^2 = 2 (mod 8), v_2(F0) = 1 — не квадрат.
      ЗНАЧИТ ровно одно из p,q чётно; пусть 2^w || pq, w >= 1.
  B2. w = 1:  F0 = 1 + 4 = 5 (mod 8) — не квадрат.  ПРЕПЯТСТВИЕ.
  B3. w >= 2:  F0 = F8 = 1 (mod 8) автоматически; p^2+q^2 = 1 (mod 8)  =>  F4 = s (mod 8);
      2mn pq = 0 (mod 8)  =>  c2 = c6 = F4 (mod 8).
      Единственное условие:  s = 1 (mod 8)  <=>  m^2+n^2 = 2 (mod 16)  <=>  m = ±n (mod 8).

СЛЕДСТВИЕ (доказано).  КРАСНЫЕ КЛЕТКИ НЕ ДОБАВЛЯЮТ НИ ОДНОГО УСЛОВИЯ ПРИ p = 2:
во всех незаблокированных случаях c2 = c6 = F4 (mod 8), а F4 = 1 (mod 8) требуется уже
для семи квадратов.  То есть C(Q_2) непусто  =>  и девятиклеточная система разрешима в Q_2.

ИТОГОВЫЙ КРИТЕРИЙ (доказано).  Система «девять клеток G1 — квадраты» разрешима в Q_2
  <=>  либо (m нечётно, n = 0 mod 4)  [и тогда годятся ровно t = ±1 (mod 8)],
       либо (m, n оба нечётны и m = ±n (mod 8))  [и тогда годятся ровно t с v_2(t) >= 2 или <= -2].
""")

def is_sq2(x):
    x = QQ(x)
    if x == 0: return True
    v = x.valuation(2)
    if v % 2: return False
    u = x / 2^v
    return (u.numerator() * u.denominator()) % 8 == 1

print("--- 2.1 Исчерпывающая проверка утверждений A1..A3, B1..B3 по вычетам ---")
bad = []
for mm in range(1, 90, 2):
    for nn in range(1, 90):
        if gcd(mm, nn) != 1: continue
        for pp in range(1, 32):
            for qq in range(1, 32):
                if gcd(pp, qq) != 1: continue
                v = CELLS(mm, nn, pp, qq)
                if nn % 2 == 0:
                    if (pp % 2) != (qq % 2):
                        if v[4].valuation(2) % 2 == 0: bad.append(("A1", mm,nn,pp,qq)); continue
                        continue
                    W = ZZ((pp*pp + qq*qq)//2)
                    if nn % 4 == 2:
                        if ZZ(v[0]) % 8 != 5 or ZZ(v[8]) % 8 != 5: bad.append(("A2", mm,nn,pp,qq))
                    else:
                        if ZZ(v[0]) % 8 != 1 or ZZ(v[8]) % 8 != 1: bad.append(("A3a", mm,nn,pp,qq))
                        if not (ZZ(v[2]) % 8 == ZZ(v[4]) % 8 == ZZ(v[6]) % 8): bad.append(("A3b", mm,nn,pp,qq))
                        if ZZ(v[4]) % 8 != W % 8: bad.append(("A3c", mm,nn,pp,qq))
                        if (ZZ(v[4]) % 8 == 1) != (pp % 8 in (qq % 8, (-qq) % 8)): bad.append(("A3d", mm,nn,pp,qq))
                else:
                    if pp % 2 == 1 and qq % 2 == 1:
                        if v[0].valuation(2) != 1: bad.append(("B1", mm,nn,pp,qq))
                        continue
                    w = ZZ(pp*qq).valuation(2)
                    s = ZZ((mm*mm + nn*nn)//2)
                    if w == 1:
                        if ZZ(v[0]) % 8 != 5: bad.append(("B2", mm,nn,pp,qq))
                    else:
                        if ZZ(v[0]) % 8 != 1 or ZZ(v[8]) % 8 != 1: bad.append(("B3a", mm,nn,pp,qq))
                        if not (ZZ(v[2]) % 8 == ZZ(v[4]) % 8 == ZZ(v[6]) % 8): bad.append(("B3b", mm,nn,pp,qq))
                        if ZZ(v[4]) % 8 != s % 8: bad.append(("B3c", mm,nn,pp,qq))
print(f"  нарушений: {len(bad)}   {bad[:3]}")

print()
print("--- 2.2 Перебор: у каких пар НЕТ 2-адической точки (семь клеток vs девять) ---")
CAND = [(a, b) for a in range(0, 97) for b in range(1, 97) if gcd(a, b) == 1]
def has_point2(mm, nn, idx):
    for (pp, qq) in CAND:
        v = CELLS(mm, nn, pp, qq)
        if all(v[i] != 0 and is_sq2(v[i]) for i in idx): return (pp, qq)
    return None
pairs = [(a, b) for a in range(2, 31) for b in range(1, a) if gcd(a, b) == 1]
n7 = n9 = 0; diff = []; mism = []
for (a, b) in pairs:
    mm, nn = (b, a) if a % 2 == 0 else (a, b)
    r7 = has_point2(mm, nn, (0,4,8)); r9 = has_point2(mm, nn, (0,2,4,6,8))
    n7 += (r7 is None); n9 += (r9 is None)
    if (r7 is None) != (r9 is None): diff.append((a,b))
    pred = (nn % 4 == 2) if nn % 2 == 0 else (mm % 8 not in (nn % 8, (-nn) % 8))
    if pred != (r9 is None): mism.append((a,b))
print(f"  пар (m,n <= 30): {len(pairs)};  без 2-ад. точки на СЕМИ клетках: {n7};  на ДЕВЯТИ: {n9}")
print(f"  пары, где КРАСНЫЕ клетки добавляют 2-адическое препятствие: {diff}  <- пусто")
print(f"  расхождений с итоговым критерием: {len(mism)}  {mism[:5]}")

# --------------------------------------------------------------------------------------------
print(); print(SEP); print("ЧАСТЬ 3. Четыре оставшиеся пары проекта — явные 2-адические точки"); print(SEP)
# --------------------------------------------------------------------------------------------
Q2 = Qp(2, 60)
for (a, b) in [(13,8), (15,8), (16,5), (19,16), (11,4), (15,1), (19,5)]:
    mm, nn = (b, a) if a % 2 == 0 else (a, b)
    r = has_point2(mm, nn, (0,2,4,6,8))
    if r is None:
        print(f"  ({a},{b}) -> (m,n)=({mm},{nn}): 2-адическая точка НЕ найдена"); continue
    v = CELLS(mm, nn, *r)
    for i in (0,2,4,6,8):
        assert (Q2(v[i]).sqrt()^2 - Q2(v[i])).valuation() >= 55
    par = f"v_2(n) = {ZZ(nn).valuation(2)}" if nn % 2 == 0 else "m,n оба нечётны"
    print(f"  ({a},{b}) -> (m,n)=({mm},{nn}), {par}: 2-адическая точка t = {r[0]}/{r[1]}; "
          f"клетки mod 8 = {[ZZ(v[i]) % 8 for i in (0,2,4,6,8)]}; все пять корней в Z_2 есть.")

print()
print("--- 3.1 t = 1 даёт красные клетки ТОЧНЫМИ квадратами при ЛЮБЫХ m,n (вырожденная точка) ---")
for (a, b) in [(13,8), (15,8), (16,5), (19,16)]:
    mm, nn = (b, a) if a % 2 == 0 else (a, b)
    v = CELLS(mm, nn, 1, 1)
    assert v[2] == (mm-nn)^2 and v[6] == (mm+nn)^2
    print(f"  ({a},{b}): c2 = (m-n)^2 = {v[2]}, c6 = (m+n)^2 = {v[6]}, c0 = c8 = {v[0]}")
print("  => утверждение «при чётном n красные клетки G1 не квадраты» ЛОЖНО буквально:")
print("     на всём G1 при t = 1 обе красные клетки — точные квадраты (квадрат при этом вырожден:")
print("     c0 = c8, c1 = c5, c3 = c7, так что различных клеток нет).")

# --------------------------------------------------------------------------------------------
print(); print(SEP); print("ЧАСТЬ 4. Семейство Весоловского: что там на самом деле доказано"); print(SEP)
# --------------------------------------------------------------------------------------------
print("""
Семейство Весоловского = G1 (x,y,z) = (m,n,t), суженное условием «c2 и c6 — квадраты вида
(xy -+ z)^2».  Так как c2 = F4 - 2xyz, условие c2 = (xy-z)^2 равносильно ОДНОМУ уравнению
        (*)   (x^2+y^2)(1+z^2) = 2(x^2 y^2 + z^2),
и тогда автоматически c6 = (xy+z)^2, а центр c4 = x^2y^2 + z^2.
Свободные («красные» у Бойера) клетки — это c0 = x^2 + y^2 z^2 и c8 = x^2 z^2 + y^2 (и центр).
""")
sols = []
for x in range(1, 1200):
    for y in range(1, x):
        if gcd(x, y) != 1: continue
        den = x*x + y*y - 2
        if den == 0: continue
        z2 = QQ(2*x*x*y*y - x*x - y*y) / den
        if z2 <= 0: continue
        if z2.is_square():
            z = z2.sqrt()
            if z != 1 and y != 1: sols.append((x, y, z))
print(f"  невырожденные решения (*) при x < 1200:  {sols}")
print("""
  Целочисленная ветвь — рекуррента:  a: 1, 3, 11, 41, 153, 571, 2131, ...,  a_{k+1} = 4 a_k - a_{k-1};
  (x, y, z) = (a_{k+1}, a_k, (a_{k+1} - a_k)/2).  Это и есть «рекуррента (x(n), y(n), z(n))».
""")
a = [1, 3]
for _ in range(14): a.append(4*a[-1] - a[-2])
print("   k |     x |     y |     z | z mod 2 | (*) | v2(c0) | v2(c8) | v2(центр) | c0 квадрат?")
for k in range(1, 12):
    x, y = a[k], a[k-1]; z = (x - y)//2
    ok = (x*x + y*y)*(1 + z*z) == 2*(x*x*y*y + z*z)
    c0v, c8v, c4v = x*x + y*y*z*z, x*x*z*z + y*y, ZZ((x*x + y*y)*(1 + z*z)/2)
    print(f"  {k:2d} | {x:5d} | {y:5d} | {z:5d} | {z%2:7d} | {str(ok):5s} | {ZZ(c0v).valuation(2):6d} |"
          f" {ZZ(c8v).valuation(2):6d} | {c4v.valuation(2):9d} | {ZZ(c0v).is_square()}")
print("""
  [доказано] На этой рекурренте x и y НЕЧЁТНЫ ВСЕГДА (4a_k - a_{k-1} сохраняет нечётность),
  а z = (x-y)/2 чередует чётность.  Когда z нечётно, ВСЕ ТРИ нечётны, и тогда
        c0 = x^2 + y^2 z^2 = 2 (mod 4),   c8 = x^2 z^2 + y^2 = 2 (mod 4),
        центр = (x^2+y^2)(1+z^2)/2 тоже имеет v_2 = 1,
  то есть v_2 = 1 — НЕЧЁТНАЯ оценка, и это НЕ квадраты.  Одна строчка, никакого спуска.
  Это ровно случай B1 части 2 (m,n оба нечётны, t — 2-адическая единица).

  [вывод о формулировке Бойера] «Чётное n» у Бойера — ИНДЕКС РЕКУРРЕНТЫ (с точностью до сдвига
  нумерации), а не наш параметр n.  На всей его кривой наш параметр n = y НЕЧЁТЕН.
  Перенос «чётное n => препятствие» на параметр n семейства G1 — подмена переменной.
""")

# --------------------------------------------------------------------------------------------
print(); print(SEP); print("ИТОГ"); print(SEP)
print("""
[доказано] Полный критерий разрешимости в Q_2 для ДЕВЯТИ клеток G1 (gcd(m,n) = 1):
   m неч., n = 2 (mod 4):            препятствие есть (F0 = F8 = 5 mod 8) — уже на СЕМИ клетках;
   m неч., 4 | n:                    препятствия НЕТ; годятся ровно t = ±1 (mod 8);
   m, n оба неч., m != ±n (mod 8):   препятствие есть (F4 = 5 mod 8);
   m, n оба неч., m = ±n (mod 8):    препятствия НЕТ; годятся ровно t с |v_2(t)| >= 2.
[доказано] Красные клетки c2, c6 НИКОГДА не добавляют условия при p = 2: в любом
   неисключённом случае c2 = c6 = F4 (mod 8).
[доказано] Гипотеза «при чётном n красные клетки G1 не квадраты» ЛОЖНА:
   при 4 | n 2-адического препятствия нет вообще, а при t = 1 красные клетки — точные квадраты.
[следствие] Пары (13,8), (15,8) (v_2(n) = 3) и (19,16), (16,5) (v_2 = 4) 2-адически НЕ закрываются.
   Ни одна из четырёх оставшихся пар не закрывается этим способом.
[доказано] Настоящая теорема Бойера–Весоловского «чётное n» — это случай «x, y, z все нечётны»
   на его рекурренте, где v_2(c0) = 1.  В терминах G1 это m, n ОБА НЕЧЁТНЫ и t — единица,
   то есть противоположная конфигурация чётностей.  К нашему чётному n отношения не имеет.
""")
